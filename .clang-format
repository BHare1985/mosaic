---
# Mosaic's formatting. LLVM base plus the overrides that make it readable at a glance; the naming and
# semantic rules live in .clang-tidy, and both are described in docs/design/conventions.md.
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
AccessModifierOffset: -4

BreakBeforeBraces: Attach
PointerAlignment: Left
ReferenceAlignment: Pointer
NamespaceIndentation: None
IndentCaseLabels: true
IndentAccessModifiers: false

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # This project's own headers are included with angle brackets, so the usual ^"..." first category
  # would never match anything here.
  - Regex: '^<mosaic/'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '.*'
    Priority: 3

SpacesBeforeTrailingComments: 2
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
